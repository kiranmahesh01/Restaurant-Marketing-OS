# =============================================================================
# Restaurant Marketing OS — environment template
# Copy to .env.local for local dev. Demo mode works with ALL keys empty.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep true until store.ts is fully backed by Supabase (see DEPLOY.md)
DEMO_MODE=true

# -----------------------------------------------------------------------------
# Supabase — project example: hphqrqkuqhxzyjbgpbvh
# URL form: https://hphqrqkuqhxzyjbgpbvh.supabase.co
# Vercel team example: magic-ai2
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for media uploads (create as "media", public or signed URLs)
SUPABASE_MEDIA_BUCKET=media

# -----------------------------------------------------------------------------
# AI content generation
# Local demo engine ALWAYS works with zero keys.
# Add one or both live providers for ChatGPT / Claude quality.
# AI_PROVIDER=auto|openai|anthropic|demo
#   auto = OpenAI if key else Anthropic if key else demo
# -----------------------------------------------------------------------------
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# Meta — Instagram + Facebook organic + Ads
# https://developers.facebook.com/
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# -----------------------------------------------------------------------------
# Google Ads
# https://developers.google.com/google-ads/api/docs/get-started/introduction
# -----------------------------------------------------------------------------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# -----------------------------------------------------------------------------
# TikTok Content Posting / Marketing API
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# X / Twitter API v2
# -----------------------------------------------------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# -----------------------------------------------------------------------------
# Video render — pick one (or both)
# Creatomate: https://creatomate.com/docs
# Shotstack:  https://shotstack.io/docs/api/
# -----------------------------------------------------------------------------
CREATOMATE_API_KEY=
CREATOMATE_TEMPLATE_ID=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

# -----------------------------------------------------------------------------
# POS connectors
# -----------------------------------------------------------------------------
# Toast
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=

# Square
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox

# Clover
CLOVER_API_TOKEN=
CLOVER_MERCHANT_ID=

# -----------------------------------------------------------------------------
# Comms
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# -----------------------------------------------------------------------------
# Cron / jobs (optional shared secret for scheduled publish worker)
# -----------------------------------------------------------------------------
CRON_SECRET=
